# Configuración de red para Machine HMI
# Este archivo contiene las IPs y puertos utilizados por el sistema

# IP de esta máquina (se detecta automáticamente)
# Puedes cambiarla manualmente si es necesario
LOCAL_IP=192.168.68.69

# Puertos de los servicios
FRONTEND_PORT=3000
BACKEND_PORT=8080

# IP del servidor OPC UA
OPCUA_SERVER_IP=192.168.68.100
OPCUA_SERVER_PORT=4840

# URLs de acceso
FRONTEND_LOCAL_URL=http://localhost:${FRONTEND_PORT}
FRONTEND_NETWORK_URL=http://${LOCAL_IP}:${FRONTEND_PORT}
BACKEND_LOCAL_URL=http://localhost:${BACKEND_PORT}
BACKEND_NETWORK_URL=http://${LOCAL_IP}:${BACKEND_PORT}
OPCUA_ENDPOINT=opc.tcp://${OPCUA_SERVER_IP}:${OPCUA_SERVER_PORT}

# Configuración de firewall (comentarios para referencia)
# macOS: sudo pfctl -d (deshabilitar firewall temporalmente)
# Linux: sudo ufw allow ${FRONTEND_PORT} && sudo ufw allow ${BACKEND_PORT}
# Windows: Permitir puertos ${FRONTEND_PORT} y ${BACKEND_PORT} en Windows Firewall