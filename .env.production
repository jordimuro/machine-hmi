# ===================================================================
# Machine HMI - Configuración de Producción para Linux RT
# ===================================================================

# ==================== Servidor ====================
# Puerto en el que escuchará el servidor
PORT=8080

# Entorno de ejecución (IMPORTANTE: mantener en production)
NODE_ENV=production

# ==================== OPC UA ====================
# Endpoint del servidor OPC UA
# Ejemplos:
#   - Servidor local: opc.tcp://localhost:4840
#   - Servidor remoto: opc.tcp://192.168.1.100:4840
#   - KEPServerEX: opc.tcp://192.168.1.50:49320
OPCUA_ENDPOINT=opc.tcp://192.168.68.100:4840

# Intervalo de polling (ms) - tiempo entre lecturas de tags
POLLING_RATE_MS=250

# ==================== Autenticación ====================
# Secreto JWT (CAMBIAR EN PRODUCCIÓN - generar uno aleatorio)
JWT_SECRET=CAMBIAR_ESTE_SECRETO_EN_PRODUCCION_12345

# PINs de acceso
# PIN para operador (acceso básico)
PIN_OPERATOR=1111

# PIN para mantenimiento (acceso completo)
PIN_MAINTENANCE=2222

# ==================== WebSocket ====================
# Intervalo de heartbeat para mantener conexión (ms)
WS_HEARTBEAT_INTERVAL_MS=30000

# ==================== Historial ====================
# Horas de retención de datos históricos
HISTORY_RETENTION_HOURS=24

# ==================== Logging ====================
# Nivel de log: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Intervalo de log de estadísticas (ms)
LOG_INTERVAL_MS=5000

# ===================================================================
# Notas de configuración:
#
# 1. OPCUA_ENDPOINT: Asegúrate de que la IP y puerto sean correctos
#    para tu servidor OPC UA en la red local
#
# 2. JWT_SECRET: Genera uno aleatorio en producción:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 3. PINs: Cambia los PINs por defecto por seguridad
#
# 4. Para encontrar tu servidor OPC UA en la red:
#    - Verifica la IP del PLC/servidor OPC UA
#    - Puerto típico: 4840 (estándar OPC UA)
#    - KEPServerEX usa 49320 por defecto
# ===================================================================
